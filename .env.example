# Required: PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres)
# Note: Vercel Postgres / Neon `POSTGRES_URL` is also auto-detected if `DATABASE_URL` is unset.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Recommended on Vercel: Vercel Blob token for CDN-hosted MP4 masters & posters.
# If omitted on Vercel, rendered MP4s persist automatically in PostgreSQL `project_assets`.
BLOB_READ_WRITE_TOKEN=

# Optional (local / Docker / Railway only): disk directory for renders. Ignored when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DIR=./storage

# Optional: Unlock live full-catalog stock video search (falls back to bundled 40-clip Pexels pool if omitted)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: Upgrade scriptwriting & voice synthesis (falls back to built-in beat engine + 24kHz Edge neural TTS)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Generative AI (scripts, rewrites, AI scene visuals) ────────────────────
# Works with NO keys via the free Pollinations tier (rate-limited: ~1 request
# per 45s per server IP, best effort). Add a key for reliable, faster, HD output.
# Pollinations key: text, Flux images AND real text-to-video clips.
# Text-to-video has no free tier: without this key, "AI video" makes motion
# shots from AI images instead. Get a key: https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# Video model (default alibaba/wan-2.2-fast, ~0.01 pollen/s). Others: bytedance/seedance-2.0-fast,
# google/veo-3.1-fast, kwaivgi/kling-v3.0-std, alibaba/wan-2.7 ... (see gen.pollinations.ai/video/models)
AI_VIDEO_MODEL=
# Clip length in seconds (2-15, default 5; must be within the model's limit).
AI_VIDEO_DURATION=
# Set to "off" to disable AI video generation.
AI_VIDEO=
# OPENAI_API_KEY (above) also powers the AI writer; set a base URL to use any
# OpenAI-compatible provider (Groq, OpenRouter, Together, ...).
OPENAI_BASE_URL=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
# Set to "off" to disable OpenAI image generation (use OpenAI only for text).
AI_IMAGES_OPENAI=
# Set to "off" to never call the free tier (built-in script engine only).
AI_FREE_TIER=
