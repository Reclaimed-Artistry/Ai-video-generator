# ─── Database (required) ────────────────────────────────────────────────
# Local / Docker: a normal Postgres URL.
# Vercel: connect Neon (Storage → Neon) and this is set for you automatically
# (POSTGRES_URL is also accepted). The projects table is created on first request.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Rendered video storage ─────────────────────────────────────────────
# Vercel (required there): connect a PUBLIC Vercel Blob store (Storage → Blob);
# this token is then injected automatically. Without it, renders are refused on Vercel.
BLOB_READ_WRITE_TOKEN=

# Docker / VPS only: persistent folder for rendered MP4s (mount a volume here).
# On Vercel this is ignored in favour of /tmp + Blob.
STORAGE_DIR=./storage

# ─── Optional upgrades ──────────────────────────────────────────────────
# Live full-catalog stock video search (falls back to the bundled Pexels clip pool).
PEXELS_API_KEY=
PIXABAY_API_KEY=

# LLM scriptwriting + premium voices (falls back to the built-in script engine
# and free 24kHz Microsoft Edge neural voices).
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
