# Required: PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres)
# Note: Vercel Postgres / Neon `POSTGRES_URL` is also auto-detected if `DATABASE_URL` is unset.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Recommended on Vercel: Vercel Blob token for CDN-hosted MP4 masters & posters.
# If omitted on Vercel, rendered MP4s persist automatically in PostgreSQL `project_assets`.
BLOB_READ_WRITE_TOKEN=

# Optional (local / Docker / Railway only): disk directory for renders. Ignored when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DIR=./storage

# Optional: Unlock live full-catalog stock video search (falls back to bundled 40-clip Pexels pool if omitted)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: Upgrade scriptwriting & voice synthesis (falls back to built-in beat engine + 24kHz Edge neural TTS)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: Pollinations (https://pollinations.ai) — OpenAI-compatible image and
# text generation. Used for AI scene images and scriptwriting when no other
# image/LLM provider key is set. Server-side only: Pollinations `sk_` secret
# keys must never be exposed in a browser, a mobile app, or a repository.
POLLINATIONS_API_KEY=
# Optional overrides — sensible defaults apply when left blank.
POLLINATIONS_IMAGE_MODEL=
POLLINATIONS_TEXT_MODEL=
POLLINATIONS_VIDEO_MODEL=

# Optional: AI scene *video* generation (text-to-video), used for scenes with no
# usable stock clip — it replaces the on-device plate + camera motion.
# HunyuanVideo (https://github.com/Tencent-Hunyuan/HunyuanVideo) is open-weight
# but needs an NVIDIA GPU with ~45GB VRAM at its smallest setting, so it cannot
# run in this app or on serverless hosting. It is reached through Replicate's
# hosted copy of the same model (`tencent/hunyuan-video`).
REPLICATE_API_TOKEN=
# Optional overrides — sensible defaults apply when left blank.
HUNYUAN_VIDEO_MODEL=
HUNYUAN_INFER_STEPS=
HUNYUAN_GUIDANCE_SCALE=
HUNYUAN_FLOW_SHIFT=
HUNYUAN_TIMEOUT_MS=
# fallback = only when a scene has no stock clip (default); always = every scene
# without an uploaded asset; off = never generate video.
AI_VIDEO_MODE=
