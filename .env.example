# Required: PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres)
# Note: Vercel Postgres / Neon `POSTGRES_URL` is also auto-detected if `DATABASE_URL` is unset.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Recommended on Vercel: Vercel Blob token for CDN-hosted MP4 masters & posters.
# If omitted on Vercel, rendered MP4s persist automatically in PostgreSQL `project_assets`.
BLOB_READ_WRITE_TOKEN=

# Optional (local / Docker / Railway only): disk directory for renders. Ignored when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DIR=./storage

# Optional: Unlock live full-catalog stock video search (falls back to bundled 40-clip Pexels pool if omitted)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: Upgrade scriptwriting & voice synthesis (falls back to built-in beat engine + 24kHz Edge neural TTS)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Generative AI (scripts, rewrites, AI scene visuals) ────────────────────
# Text works with NO card: Gemini and Groq both have free tiers and speak the
# OpenAI wire format. Provider order is OpenAI → Gemini → Groq. With no key at
# all the built-in script engine writes the script.
# Gemini (free tier ~15 RPM / 500 RPD): https://aistudio.google.com/apikey
# Newer Gemini keys start with "AQ." and must travel in the x-goog-api-key
# header; legacy "AIza" keys are sent as a bearer token. Both are handled
# automatically — you do not need to know which one you have.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
# Only meaningful on Gemini 3.x. Leave unset on 2.5, which rejects the param.
GEMINI_REASONING_EFFORT=
# Groq (free tier 30 RPM / 1,000 RPD): https://console.groq.com/keys
# Do not use llama-3.3-70b-versatile — Groq retired it from the free tier.
GROQ_API_KEY=
GROQ_TEXT_MODEL=
# Set to "off" to drop JSON mode, for providers that reject response_format.
LLM_JSON_MODE=
# Point any provider at a proxy or self-hosted gateway (OpenRouter, LiteLLM).
LLM_BASE_URL=
# Set to "1" to enable GET /api/verify-llm, which runs one real request
# against the configured LLM and reports what came back.
ENABLE_LLM_PROBE=
# OPENAI_API_KEY (above) also powers the AI writer; set a base URL to use any
# OpenAI-compatible provider (Together, Fireworks, ...).
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=
AI_IMAGE_MODEL=
# Set to "off" to disable OpenAI image generation (use OpenAI only for text).
AI_IMAGES_OPENAI=

# ─── AI video (needs REPLICATE_API_TOKEN) ───────────────────────────────────
# Text-to-video has no free tier: without this token, "AI video" makes motion
# shots from AI images instead. https://replicate.com/account/api-tokens
# When to spend money: "fallback" (default, only scenes with no usable stock
# clip), "always" (every scene without an uploaded asset), or "off".
REPLICATE_API_TOKEN=
AI_VIDEO_MODE=
# Model (default tencent/hunyuan-video).
AI_VIDEO_MODEL=
# Clip length in seconds (2-15, default 5; must be within the model's limit).
AI_VIDEO_DURATION=
# Set to "off" to disable AI video generation.
AI_VIDEO=
# Public address of your site. The AI service downloads character images and
# voice clips from here, so it must be reachable from the internet (not
# localhost). Not needed when Vercel Blob is connected.
PUBLIC_APP_URL=
