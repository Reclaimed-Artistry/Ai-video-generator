# Required: PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres)
# Note: Vercel Postgres / Neon `POSTGRES_URL` is also auto-detected if `DATABASE_URL` is unset.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Recommended on Vercel: Vercel Blob token for CDN-hosted MP4 masters & posters.
# If omitted on Vercel, rendered MP4s persist automatically in PostgreSQL `project_assets`.
BLOB_READ_WRITE_TOKEN=

# Optional (local / Docker / Railway only): disk directory for renders. Ignored when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DIR=./storage

# Optional: Unlock live full-catalog stock video search (falls back to bundled 40-clip Pexels pool if omitted)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: Flaq AI (https://flaq.ai) — ONE paid key for scripting, imagery and
# video. Takes precedence over the providers below when set. Prepaid credits
# (from $10); not a free tier.
FLAQ_API_KEY=
# Optional overrides. Defaults: gpt-5.6-luna-text-to-text (LLM),
# gpt-image-2 (image), seedance-v2.5-text-to-video (video).
FLAQ_BASE_URL=
FLAQ_TEXT_MODEL=
FLAQ_IMAGE_MODEL=
FLAQ_VIDEO_MODEL=
FLAQ_IMAGE_RESOLUTION=
FLAQ_VIDEO_RESOLUTION=
FLAQ_IMAGE_TIMEOUT_MS=
FLAQ_VIDEO_TIMEOUT_MS=
FLAQ_POLL_MS=

# Optional: Upgrade scriptwriting & voice synthesis (falls back to built-in beat engine + 24kHz Edge neural TTS)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional FREE LLMs for AI scriptwriting (no credit card). Either one restores
# LLM script drafting; without one, scripts come from the built-in beat engine.
# Gemini  — free tier ~15 RPM / 500 RPD. Key: https://aistudio.google.com/apikey
#           (GEMINI_API_KEY also powers AI imagery, so one key covers both.)
# Groq    — free tier ~30 RPM / 1,000 RPD. Key: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides — model names change often on both providers.
GEMINI_TEXT_MODEL=
GROQ_TEXT_MODEL=
# Set to "off" if the chosen model rejects `response_format: json_object`;
# the reply is then parsed leniently instead.
LLM_JSON_MODE=
# Cap on generated tokens per script. Reasoning models spend part of this
# on thinking; raise it if scripts come back truncated. Default: 1500 + 600/scene.
LLM_MAX_TOKENS=
# Point any provider at a proxy/gateway/self-hosted endpoint (OpenRouter,
# LiteLLM, corporate egress proxy). Overrides the provider default URL.
LLM_BASE_URL=
# Gemini only: low|medium|high|none. Off unless set — Google only documents
# it for Gemini 3.x, and an unsupported param is a hard 400.
GEMINI_REASONING_EFFORT=
# Expose GET /api/verify-llm in production so you can prove the LLM works
# end to end. Off by default (it is unauthenticated and spends tokens).
ENABLE_LLM_PROBE=

# Optional: AI scene *video* generation (text-to-video), used for scenes with no
# usable stock clip — it replaces the on-device plate + camera motion.
# HunyuanVideo (https://github.com/Tencent-Hunyuan/HunyuanVideo) is open-weight
# but needs an NVIDIA GPU with ~45GB VRAM at its smallest setting, so it cannot
# run in this app or on serverless hosting. It is reached through Replicate's
# hosted copy of the same model (`tencent/hunyuan-video`).
REPLICATE_API_TOKEN=
# Optional overrides — sensible defaults apply when left blank.
HUNYUAN_VIDEO_MODEL=
HUNYUAN_INFER_STEPS=
HUNYUAN_GUIDANCE_SCALE=
HUNYUAN_FLOW_SHIFT=
HUNYUAN_TIMEOUT_MS=
# fallback = only when a scene has no stock clip (default); always = every scene
# without an uploaded asset; off = never generate video.
AI_VIDEO_MODE=
